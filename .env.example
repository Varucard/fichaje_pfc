# Copiar este archivo como ".env" y completar los valores. El .env NO se versiona.

# --- Aplicación ---
SITENAME="Palillo Fight Club"
APPVERSION=3.4.0
# URL pública de la app. En XAMPP: http://localhost/fichaje_pfc  | En Docker: http://localhost:8080
APP_URL=http://localhost:8080
# true muestra el detalle de los errores en pantalla (solo para desarrollo)
APP_DEBUG=false
APP_TIMEZONE=America/Argentina/Buenos_Aires

# --- Seguridad del acceso ---
# Intentos fallidos permitidos (por DNI / por IP) dentro de la ventana antes de bloquear
LOGIN_MAX_INTENTOS=5
LOGIN_MAX_INTENTOS_IP=20
LOGIN_VENTANA_MINUTOS=15
LOGIN_BLOQUEO_MINUTOS=15
# Minutos sin uso antes de cerrar la sesión (0 = nunca)
SESION_INACTIVIDAD_MINUTOS=120

# --- Base de datos ---
# En Docker el host es el nombre del servicio: mysql
MYSQL_DB_HOST=mysql
MYSQL_DB_PORT=3306
MYSQL_DB_NAME=pfc
MYSQL_DB_USER=pfc
MYSQL_DB_PASSWORD=cambiar-esta-clave
# Solo Docker: clave del usuario root de MySQL
MYSQL_ROOT_PASSWORD=cambiar-esta-clave-root

# --- Lector Arduino ---
IP_ARDUINO=192.168.0.36
ARDUINO_PORT=8080
# Mismo valor que PFC_API_TOKEN en firmware/pfc/config.h.
# Generar uno con: php -r "echo bin2hex(random_bytes(16));"
ARDUINO_TOKEN=

# Minutos en los que no se registra otra fichada del mismo alumno (0 = desactivado)
MINUTOS_ENTRE_FICHADAS=5

# --- Liquidación de profesores ---
# Porcentaje por defecto de lo cobrado en sus clases (cada profesor puede tener el suyo)
LIQUIDACION_PORCENTAJE=50

# --- Fichadas ---
# Minutos antes del inicio de una clase en que la fichada ya cuenta para esa clase
MINUTOS_ANTES_DE_CLASE=30

# --- Pagos ---
# Días alrededor del vencimiento en que la cuota se marca en rojo
DIAS_AVISO_VENCIMIENTO=5

# --- Emails ---
# smtp = envía de verdad | log = guarda los mails en storage/emails sin enviarlos
MAIL_MODO=smtp
# Gmail: activar la verificación en 2 pasos y crear una "contraseña de aplicación"
# en https://myaccount.google.com/apppasswords (NO usar la contraseña normal).
MAIL_HOST=smtp.gmail.com
MAIL_PUERTO=587
MAIL_SEGURIDAD=tls
MAIL_USUARIO=avisos.palillo@gmail.com
MAIL_PASSWORD=
MAIL_REMITENTE=avisos.palillo@gmail.com
MAIL_REMITENTE_NOMBRE="Palillo Fight Club"
# Desarrollo con Docker: MAIL_HOST=mailpit, MAIL_PUERTO=1025, MAIL_SEGURIDAD=ninguna, MAIL_USUARIO= (vacío)
# y los mails se ven en http://localhost:8025

# --- Logs ---
# Nivel mínimo de los logs técnicos: debug | info | warning | error
LOG_NIVEL=info
# Días que se conservan los archivos de storage/logs (0 = no borrar)
LOG_DIAS_RETENCION=90

# --- Respaldos ---
# Carpeta donde se guardan los backups (por defecto storage/backups)
BACKUP_DIR=
# Backup diario automático (bin/tareas.php), a partir de BACKUP_HORA
BACKUP_AUTOMATICO=true
BACKUP_HORA=3
# Días que se conservan los backups (siempre quedan los 3 últimos). 0 = no borrar
BACKUP_DIAS_RETENCION=30
