{
  "name": "varucard/fichaje-pfc",
  "description": "Sistema de fichajes, pagos y clases para Palillo Fight Club con lector RFID (Arduino).",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "ext-dom": "*",
    "ext-gd": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "dompdf/dompdf": "^3.0",
    "phpmailer/phpmailer": "^6.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "suggest": {
    "ext-curl": "Necesaria para reiniciar el lector Arduino desde el panel."
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    },
    "files": [
      "src/Support/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "find src config public views bin tests -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null",
    "serve": "php -S localhost:8000 -t public public/index.php",
    "crear-admin": "php bin/crear-admin.php",
    "migrar": "php bin/migrar.php"
  },
  "config": {
    "sort-packages": true,
    "platform-check": false
  }
}
